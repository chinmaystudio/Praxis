{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avengers-doomsday",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "routes": [
    {
      "pattern": "praxis26.in",
      "custom_domain": true
    },
    {
      "pattern": "www.praxis26.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
